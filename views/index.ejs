<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mini App Store</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="apple-touch-icon" href="/favicon.ico">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
</head>
<body>
    <header class="header">
        <div class="container">
            <div class="header-content">
                <a href="/" class="logo">
                    <div class="logo-icon">📱</div>
                    <div class="logo-text">Mini App Store</div>
                </a>
                <a href="/maker" class="nav-button">Create App</a>
            </div>
        </div>
    </header>

    <main class="main">
        <div class="container">
            <h1 class="page-title">Discover Apps</h1>
            <p class="page-subtitle">Find and install amazing web apps as iOS shortcuts</p>

            <% if (apps.length === 0) { %>
                <div class="empty-state">
                    <div class="empty-icon">📱</div>
                    <h2 class="empty-title">No Apps Yet</h2>
                    <p class="empty-text">Be the first to create an app for the store!</p>
                    <a href="/maker" class="nav-button">Create Your First App</a>
                </div>
            <% } else { %>
                <div class="apps-grid">
                    <% apps.forEach(function(app) { %>
                        <div class="app-card">
                            <% if (app.icon) { %>
                                <img src="<%= app.icon %>" alt="<%= app.name %>" class="app-icon">
                            <% } else { %>
                                <div class="app-icon default">
                                    <%= app.name.charAt(0).toUpperCase() %>
                                </div>
                            <% } %>
                            <h3 class="app-name"><%= app.name %></h3>
                            <p class="app-description"><%= app.description %></p>
                            <button class="install-button" onclick="installApp('<%= app.id %>')">
                                Install on iOS
                            </button>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>
    </main>

    <script>
        function installApp(appId) {
            // Check if on iOS
            const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent);
            
            if (isIOS) {
                // Direct download for iOS
                window.location.href = `/api/apps/${appId}/mobileconfig`;
            } else {
                // Show instructions for non-iOS devices
                alert('This feature is designed for iOS devices. Please open this page on your iPhone or iPad to install the app.');
            }
        }

        // Add some interactivity
        document.addEventListener('DOMContentLoaded', function() {
            const cards = document.querySelectorAll('.app-card');
            
            cards.forEach(card => {
                card.addEventListener('mouseenter', function() {
                    this.style.transform = 'translateY(-8px)';
                });
                
                card.addEventListener('mouseleave', function() {
                    this.style.transform = 'translateY(-4px)';
                });
            });
        });
    </script>
</body>
</html>